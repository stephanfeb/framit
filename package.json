{
  "name": "framit",
  "version": "0.0.1",
  "description": "Local MCP server that turns text descriptions into editable, themed wireframes.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "framit": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/build-runtime.mjs",
    "dev": "tsup --watch",
    "serve": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "elkjs": "0.12.0",
    "hono": "4.13.13",
    "lucide": "1.58.0",
    "playwright": "1.64.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "esbuild": "^0.25.11",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
